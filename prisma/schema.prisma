// Prisma schema for HRProa.
//
// Local development uses SQLite so anyone can `npm install && npx prisma migrate dev`
// with zero setup (no database server to install). Production is expected to run on
// PostgreSQL — see documentation.md "Database" section for the one-line switch.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum SubmissionStatus {
  NEW
  REVIEWED
}

enum InquiryType {
  CONTACT
  CONSULTATION
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  role         Role         @default(USER)
  createdAt    DateTime     @default(now())
  sessions     Session[]
  submissions  Submission[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// A candidate's self-introduction: resume (required) + optional video, reviewed
// by an admin from the /admin inbox.
model Submission {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  note        String?
  resumePath  String
  videoPath   String?
  status      SubmissionStatus @default(NEW)
  createdAt   DateTime         @default(now())
}

// General contact / consultation-request messages from the public forms
// (Contact, Book Consultation). Kept separate from Submission since these
// don't require an account.
//
// `type` distinguishes the two forms because they're handled differently:
// a CONSULTATION request needs a manual phone confirmation call (hence
// `phone`), a plain CONTACT message doesn't.
model Inquiry {
  id        String           @id @default(cuid())
  type      InquiryType      @default(CONTACT)
  name      String
  email     String
  phone     String?
  message   String
  status    SubmissionStatus @default(NEW)
  createdAt DateTime         @default(now())
}
