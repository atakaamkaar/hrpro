# Local dev default — SQLite, zero setup required.
# For production, point this at a real PostgreSQL instance instead, e.g.
# DATABASE_URL="postgresql://user:password@host:5432/hrproa"
# and change `provider = "sqlite"` to `provider = "postgresql"` in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Used to sign the CAPTCHA challenge tokens. Any long random string works —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET="replace-with-a-long-random-string"
