# A Postgres connection string — a free Neon project (https://neon.tech) works well
# for both local dev and production. Copy the "connection string" it gives you, e.g.:
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL=""

# From your Vercel project's Storage tab -> Blob store -> .env.local tab.
# Running `vercel env pull` after linking the project also fetches this automatically.
BLOB_READ_WRITE_TOKEN=""

# Used to sign the CAPTCHA challenge tokens. Any long random string works —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET="replace-with-a-long-random-string"
