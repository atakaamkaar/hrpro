# Postgres connection strings. If you added Neon through the Vercel integration
# with the prefix "DATABASE", both of these are created for you — run
# `vercel env pull .env` to fetch them. DATABASE_URL is the pooled connection the
# app uses at runtime; DATABASE_URL_UNPOOLED is the direct one Prisma migrations
# need.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# From your Vercel project's Storage tab -> Blob store -> .env.local tab.
# Running `vercel env pull` after linking the project also fetches this automatically.
BLOB_READ_WRITE_TOKEN=""

# Used to sign the CAPTCHA challenge tokens. Any long random string works —
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CAPTCHA_SECRET="replace-with-a-long-random-string"
